# Copy to .env and set a real password. Never commit .env.
POSTGRES_DB=wob
POSTGRES_USER=wob
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://wob:change-me@localhost:5432/wob
TEST_DATABASE_URL=postgresql+psycopg://wob:change-me@localhost:5432/wob_test

# Must match the chosen embedding model before the first migration runs.
EMBEDDING_DIM=768

# Authentication. SECRET_KEY encrypts two-factor secrets: generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and keep it stable and out of the database. COOKIE_SECURE=false only for local plain http.
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# Ingestion worker. Malware scanning uses the clamav service (make worker starts it).
# SCANNER=disabled is for development only and is refused in production.
SCANNER=clamav
# local = nomic-embed-text-v1.5 run on this server (768 dims; evidence stays in-house).
# voyage = Voyage AI hosted API (set VOYAGE_API_KEY and a matching EMBEDDING_MODEL/EMBEDDING_DIM;
# sends evidence text to a third party, so clear it with data protection first).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# Cross-encoder that reranks fused search results (local | voyage | none).
RERANKER_PROVIDER=local
RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en

# Claim extraction (FR-06) sends candidate evidence to Anthropic's Claude API: cross-border
# processing of personal data (spec §12). Keep it disabled until the data protection review
# approves it, then set LLM_PROVIDER=anthropic, EXTERNAL_AI_PROCESSING_APPROVED=true and a key.
LLM_PROVIDER=disabled
EXTERNAL_AI_PROCESSING_APPROVED=false
ANTHROPIC_API_KEY=
CLAIM_MODEL=claude-opus-5-5

# External research (FR-13) searches the public web about each nominee through Claude's web
# search and fetch tools. Needs everything above plus its own switch.
RESEARCH_ENABLED=false

# Files are encrypted at rest (AES-256-GCM envelope encryption). Generate a key with
#   cd backend && uv run python -m app.cli generate-file-key
# Store keys in a secrets manager, separately from database and file backups: losing them
# makes every stored file unreadable. To rotate: add a new key, make it active, run
# `make rotate-file-key`, then `make verify-storage`, then remove the old key.
FILE_ENCRYPTION_KEYS=
FILE_ENCRYPTION_ACTIVE_KEY=
# Roles that must use two-factor sign-in. Keep the default in production.
# MFA_REQUIRED_ROLES=["admin","committee"]
# Require the finalist's consent (part A) to be recorded before evidence is uploaded.
# Recommended for real nominations (data protection review §4.1).
UPLOAD_REQUIRES_CONSENT=false
# LLM_PROVIDER=openrouter sends requests via OpenRouter's Anthropic-compatible endpoint, pinned to
# Anthropic as the serving provider with no fallback and no data collection. OpenRouter is then
# an extra processor: name it in the finalist notice before using real nominations.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Invitation emails. disabled (admins share the link shown on screen), console (printed in the
# API log; development only) or smtp. DigitalOcean droplets can't use ports 25/465/587, so pick a
# provider that accepts port 2525 (Brevo, Mailgun, Postmark, Resend, SendGrid, ...).
EMAIL_BACKEND=disabled
# EMAIL_FROM=awards@your-domain.org
# EMAIL_REPLY_TO=secretariat@your-domain.org
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
